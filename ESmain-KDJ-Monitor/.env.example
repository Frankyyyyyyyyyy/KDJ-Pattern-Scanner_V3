# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，不会被提交。

# ====== 数据源 ======
# Polygon.io 期货 API key（首选）
POLYGON_API_KEY=

# 数据源优先顺序：polygon,yahoo,offline
DATA_SOURCE_PRIORITY=polygon,yahoo,offline

# ====== 邮件通知 ======
# 留空则禁用邮件
SENDER_EMAIL=
SENDER_NAME=ESmain KDJ Monitor
# Gmail App Password (https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=
RECEIVER_EMAIL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ====== 策略阈值 ======
MONTHLY_J_THRESHOLD=55
WEEKLY_J_THRESHOLD=10
DAILY_J_THRESHOLD=0

# （已移除 ALERT_DEDUP_DAYS：现在不再去重，每个交易日满足条件就发邮件，
#  邮件中已含三档强度标签）
